    <string name="permission_read_phone_state_title">需要授予权限: 管理通话</string>
    <string name="permission_read_phone_state_description">由于Android 8中的一个Bug，发送短信需要授予管理通话的权限。</string>

    <!-- USAGE_ACCESS_SETTINGS Permission -->
    <string name="permission_usage_access_title">需要授予权限: 使用情况访问</string>
    <string name="permission_usage_access_description">为了确定设备的最后一次使用时间，需要授予使用访问统计的特殊权限。\n\n请为 Keep Alive 启用该权限。</string>

    <!-- MANAGE_OVERLAY_PERMISSION Permission -->
    <string name="permission_manage_overlay_title">需要授予权限: 显示在其他应用的上层</string>
    <string name="permission_manage_overlay_description">需要悬浮窗权限以：\n\n• 在触发\'你还在吗？\'检查时，在其他应用上方显示全屏提示，避免误发提醒。\n\n• 在配置了紧急联系电话号码时，在后台拨打电话。\n\n请在设备设置中为 Keep Alive 应用启用此权限。</string>

    <!-- ACCESS_FINE_LOCATION Permission -->
    <string name="permission_access_fine_location_title">需要授予权限: 访问精确位置信息</string>
    <string name="permission_access_fine_location_description">启用“附带位置信息”后，需要获取精确的位置信息，使其尽可能准确，以帮助联系人找到你。</string>

    <!-- POST_NOTIFICATIONS Permission (For TIRAMISU and above) -->
    <string name="permission_post_notifications_title">需要授予权限: 发送通知</string>
    <string name="permission_post_notifications_description">仅在触发提醒时发送通知</string>

    <!-- ACCESS_BACKGROUND_LOCATION Permission (For Q and above) -->
    <string name="permission_access_background_location_title">需要授予权限: 在后台访问位置信息</string>
     <string name="permission_access_background_location_description">启用“附带位置信息”后，这需要在后台运行时获取位置信息的能力。 只有在触发提醒时才会获取位置信息。只有在App处于后台且设备处于闲置状态时，提醒才会被触发。 请在设置中选择“总是允许”，为 Keep Alive 应用程序启用此权限。</string>

    <!-- REQUEST_SCHEDULE_EXACT_ALARM Permission (For S and above) -->
    <string name="permission_schedule_alarms_title">需要授予权限: 闹钟和提醒</string>
    <string name="permission_schedule_alarms_description">需要授予闹钟和提醒权限，这样即使设备处于睡眠或勿扰模式，提醒也能触发。\n\n请在设置中为 KeepAlive 启用此权限。</string>
    <string name="permission_full_screen_intent_title">需要权限：全屏通知</string>
    <string name="permission_full_screen_intent_description">需要授予全屏通知权限才能在锁定的屏幕上显示“你还在吗？”，以确保手机锁定时不会错失报平安的机会。\n\n请在下一个屏幕中为 Keep Alive 应用启用“全屏通知”。</string>

